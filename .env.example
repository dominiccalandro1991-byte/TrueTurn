# TrueTurn environment placeholders. Never put real secrets in this file.
# Node
NODE_ENV=development
# Authoritative match server (apps/server) — not used by the preview client.
TRUETURN_WS_HOST=0.0.0.0
TRUETURN_WS_PORT=8787
# Session signing for a future auth deployment (leave blank in Phase 1).
# SESSION_SECRET=
# Postgres (deferred)
# DATABASE_URL=postgresql://user:pass@localhost:5432/trueturn
# Redis (deferred)
# REDIS_URL=redis://localhost:6379
# Avatar provider (mock is default)
AVATAR_ADAPTER=mock
# AVATAR_PROVIDER_URL=
# AVATAR_PROVIDER_KEY=
